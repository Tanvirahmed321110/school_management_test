<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== WINDOW ACTION ========== -->
    <record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ========== TEACHER SEQUENCE  ========== -->
    <record id="seq_school_teacher" model="ir.sequence">
        <field name="name">School Teacher</field>
        <field name="code">school.teacher</field>
        <field name="prefix">TCH-</field>  <!-- যেমন: TCH-300, TCH-301 -->
        <field name="padding">3</field>     <!-- 3 digit -> 300, 301, 302 -->
        <field name="number_next">300</field>  <!-- 300 থেকে শুরু হবে -->
        <field name="number_increment">1</field>  <!-- 1 করে বাড়বে -->
        <field name="company_id" eval="False"/>
    </record>

    <!-- ========== LIST VIEW  ========== -->
    <record id="view_school_teacher_list" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="gender"/>
                <field name="date_of_birth"/>
            </list>
        </field>
    </record>

    <!-- ========== Form VIEW ========== -->
    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_of_birth"/>
                            <field name="teacher_id"/>
                            <field name="class_teacher_of"/>
                        </group>
                        <group>
                            <field name="image_1920" class="oe_avatar" widget="image"/>
                            <field name="age"/>
                            <field name="is_active"/>
                            <field name="gender"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Contact Info">
                            <group>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="address"/>
                            </group>
                        </page>
                        <page string="Professional Information">
                            <group>
                                <field name="qualification"/>
                                <field name="experience_years"/>
                                <field name="specialization"/>
                                <field name="joining_date"/>
                            </group>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="date_of_birth"/>
                                <field name="address"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ========== Search VIEW (Form View) ========== -->
    <record id="view_school_teacher_search" model="ir.ui.view">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search>
                <!-- Search by Roll Number -->
                <field name="teacher_id" string="Teacher ID" placeholder="search by Teacher Id..."/>

                <!-- Search by name -->
                <field name="name" string="name" placeholder="search by name..."/>

                <!-- Filter by Gender -->
                <filter
                        name="male_gender"
                        string="Male Gender"
                        domain="[('gender', '=', 'male')]"
                />
                <!-- Filter by Gender -->
                <filter
                        name="female_gender"
                        string="Female Gender"
                        domain="[('gender', '=', 'female')]"
                />
            </search>
        </field>
    </record>


    <!-- ========== Grade Action  ========== -->
    <record id="action_teacher_grade" model="ir.actions.act_window">
        <field name="name">Teacher Grades</field>
        <field name="res_model">school.teacher.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ========== Grade Action List view  ========== -->
    <record id="view_teacher_grade_tree" model="ir.ui.view">
        <field name="name">teacher.grade.tree</field>
        <field name="model">school.teacher.grade</field>
        <field name="arch" type="xml">
            <list string="Teacher Grades">
                <field name="name"/>
                <field name="salary_ids" string="Salaries" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- ========== Grade Action Form view  ========== -->
    <record id="view_teacher_grade_form" model="ir.ui.view">
        <field name="name">teacher.grade.form</field>
        <field name="model">school.teacher.grade</field>
        <field name="arch" type="xml">
            <form string="Teacher Grades">
                <field name="name"/>
                <field name="salary_ids" string="Salaries" widget="many2many_tags"/>
            </form>
        </field>
    </record>


    <!-- ================================================ -->
    <!-- Action for Teacher Salary                        -->
    <!-- ================================================ -->
    <record id="action_school_teacher_salary" model="ir.actions.act_window">
        <field name="name">Teacher Salaries</field>
        <field name="res_model">school.teacher.salary</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ========== Grade Action List view  ========== -->
    <record id="view_school_teacher_salary_tree" model="ir.ui.view">
        <field name="name">school.teacher.salary.tree</field>
        <field name="model">school.teacher.salary</field>
        <field name="arch" type="xml">
            <list string="Teacher Salaries" editable="top">
                <field name="amount" string="Salary Amount" widget="monetary" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- ========== Salary Action Form view  ========== -->
    <record id="view_school_teacher_salary_form" model="ir.ui.view">
        <field name="name">school.teacher.salary.form</field>
        <field name="model">school.teacher.salary</field>
        <field name="arch" type="xml">
            <form string="Teacher Salary">
                <sheet>

                    <group>
                        <field name="amount" string="Salary Amount" required="1" widget="monetary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>