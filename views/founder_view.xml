<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== WINDOW ACTION ========== -->
    <record id="action_school_founder" model="ir.actions.act_window">
        <field name="name">Founder</field>
        <field name="res_model">school.founder</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========== LIST VIEW  ========== -->
    <record id="view_school_founder_list" model="ir.ui.view">
        <field name="name">school.founder.tree</field>
        <field name="model">school.founder</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="start_journey"/>
            </list>
        </field>
    </record>

    <!-- ========== Form VIEW ========== -->
    <record id="view_school_founder_form" model="ir.ui.view">
        <field name="name">school.founder.form</field>
        <field name="model">school.founder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="start_journey"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="image" class="oe_avatar" widget="image"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


</odoo>