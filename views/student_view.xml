<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== WINDOW ACTION ========== -->
    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!-- ========== TREE VIEW (List View) ========== -->
    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.tree</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_even_roll"/>
                <field name="roll"/>
                <field name="admission_date"/>
            </list>
        </field>
    </record>

    <!-- ========== Form VIEW (Form View) ========== -->
    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="roll"/>
                            <field name="admission_date"/>
                        </group>
                        <group>
                            <field name="image_1920" class="oe_avatar" widget="image"/>
                            <field name="gender"/>
                            <field name="class_name"/>
                            <field name="is_even_roll" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Parent Info">
                            <group>
                                <field name="father_name"/>
                                <field name="mother_name"/>
                            </group>
                        </page>
                        <page string="Contact Info">
                            <group>
                                <field name="phone"/>
                                <field name="address"/>
                            </group>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="date_of_birth"/>
                                <field name="address"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========== KANBAN VIEW ========== -->
    <record id="view_school_student_kanban" model="ir.ui.view">
        <field name="name">school.student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="roll"/>
                <field name="class_name"/>
                <field name="image_1920"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card" style="border-radius:8px !important">

                            <!-- for image -->
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('school.student','image_1920',record.id.raw_value)" style="border-radius:4px !important"/>
                            </div>
                             <!-- Content -->
                            <div class="o_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>

                                <div>
                                    Roll: <field name="roll"/>
                                </div>
                                <div>
                                    Class: <field name="class_name"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- ========== Search VIEW (Form View) ========== -->
    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <!-- Search by Roll Number -->
                <field name="roll" string="Roll Number" placeholder="search by roll number..."/>

                <!-- Search by name -->
                <field name="name" string="name" placeholder="search by name..."/>

                <!-- Filter by roll 1-10 -->
                <filter
                        name="roll_1_10"
                        string="Roll 1-10"
                        domain="[('roll', '&gt;=', 1), ('roll', '&lt;=', 10)]"
                />

                <!-- Filter by class seven students -->
                <filter
                        name="class_seven_student"
                        string="Class Seven Students"
                        domain="[('class_name', '=', 'seven')]"
                />
                <separator/>

                <filter name="even_roll"
                        string="Even Rolls"
                        domain="[('is_even_roll','=',True)]"
                />

                <!-- Group By -->
                <group expand="0">
                    <filter name="group_by_roll"
                            string="group_by_roll"
                            context="{'group_by': 'roll'}"/>
                </group>
            </search>
        </field>
    </record>

     <!-- ========== Class Six Action ========== -->
    <record id="action_class_six" model="ir.actions.act_window">
        <field name="name">class.six.students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('class_name','=','six')]</field>
        <field name="context">{'default_class_name': 'six'}</field>
    </record>

     <!-- ========== Class  Seven Action ========== -->
    <record id="action_class_seven" model="ir.actions.act_window">
        <field name="name">class.six.students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('class_name','=','seven')]</field>
        <field name="context">{'default_class_name': 'seven'}</field>
    </record>
</odoo>